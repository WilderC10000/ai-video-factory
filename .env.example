# Copy this file to .env and fill in real values as needed.
# Nothing in Milestone 1 requires any paid API key.

# SQLite database location (relative to project root)
DATABASE_URL=sqlite:///./data/videofactory.db

# Where generated files (keyframes, clips, voiceover, final video) are stored per project
PROJECT_DATA_DIR=./data/projects

# Global kill switch: when true, no provider (real or mock) will run generation.
FACTORY_PAUSED=false

# Spending guardrails (placeholders for Milestone 9+; enforced later, recorded from the start)
MAX_SPEND_PER_PROJECT_USD=5.00
MAX_DAILY_SPEND_USD=20.00
MAX_REGENERATIONS_PER_SHOT=3

# Video generation job guardrails
VIDEO_JOB_TIMEOUT_SECONDS=300
MAX_JOB_POLL_RETRIES=3

# --- Real provider keys ---
# FAL_API_KEY is read by the fal.ai adapters (app/providers/video/fal.py,
# app/providers/image/fal.py), but those adapters are NOT the active
# provider anywhere in the app yet - setting this alone does not enable any
# real spend. Get a key at https://fal.ai/dashboard/keys.
# FAL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
